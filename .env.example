# Copy this file to .env and fill in your Neon PostgreSQL credentials
# Note: Make sure DB_URL starts with jdbc:postgresql:// and includes ?sslmode=require

SERVER_PORT=8080
DB_URL=jdbc:postgresql://ep-your-endpoint.region.aws.neon.tech/neondb?sslmode=require
DB_USERNAME=neondb_owner
DB_PASSWORD=your_neon_password

